# Google OAuth credentials (create at console.cloud.google.com, Drive API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 32-byte base64-encoded key: `openssl rand -base64 32`
APP_ENCRYPTION_KEY=
# 32-byte base64-encoded key for signed cookies: `openssl rand -base64 32`
SESSION_SECRET=

# Origins
API_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# DB: 'sqlite' (default) or 'postgres'
DB_DRIVER=sqlite
# For sqlite: file path. For postgres: connection string.
DATABASE_URL=./notdrive.db

# Postgres SSL (ignored for sqlite).
#   disable    — no TLS (default; fine for local docker)
#   require    — TLS with system-CA validation (most hosted providers)
#   no-verify  — TLS without cert validation (ad-hoc testing only)
DATABASE_SSL=disable
# Optional path to a CA cert (e.g. AWS RDS global-bundle.pem) when DATABASE_SSL=require.
# Download from https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DATABASE_SSL_CA=/etc/ssl/rds-global-bundle.pem

# Optional: cap for Drive recursive tree fetch depth (default 4)
DRIVE_TREE_DEPTH=4

# Optional: comma-separated email domains allowed to sign in (e.g. "acme.com,contractor.com").
# Empty or unset = anyone with a Google account can sign in.
ALLOWED_EMAIL_DOMAINS=

# Log level: trace|debug|info|warn|error
LOG_LEVEL=debug
NODE_ENV=development
PORT=3000
