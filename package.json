{
  "name": "notdrive",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "24.18.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' run dev",
    "dev:api": "pnpm --filter @notdrive/api run dev",
    "dev:web": "pnpm --filter @notdrive/web run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @notdrive/api run db:migrate",
    "db:generate": "pnpm --filter @notdrive/api run db:generate",
    "db:studio": "pnpm --filter @notdrive/api run db:studio",
    "jobs:run": "pnpm --filter @notdrive/api run jobs:run"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": ["biome check --write --no-errors-on-unmatched"]
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"],
    "overrides": {
      "@babel/core": "7.29.7",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "linkify-it": "5.0.2",
      "markdown-it": "14.3.0",
      "qs": "6.15.3"
    }
  }
}
