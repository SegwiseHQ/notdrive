# Frontend env — read by Vite at build/dev time.
# Copy to apps/web/.env (or .env.local) and set values.
# Anything prefixed with VITE_ is exposed to the browser bundle.

# URL of the NotDrive API (Hono server). Must match the API's API_ORIGIN
# and be in the API's WEB_ORIGIN allow-list for CORS.
#
# Local dev:    http://localhost:3000
# Production:   https://api.notdrive.example.com
VITE_API_ORIGIN=http://localhost:3000
