{
  "name": "@notdrive/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    "./app-type": "./src/app-type.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "migrate:prod": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit generate && tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "jobs:run": "tsx src/jobs/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "@hono/zod-validator": "0.4.2",
    "@notdrive/shared": "workspace:*",
    "adm-zip": "0.5.16",
    "better-sqlite3": "11.5.0",
    "bottleneck": "2.19.5",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.36.4",
    "google-auth-library": "9.15.1",
    "googleapis": "144.0.0",
    "hono": "4.6.13",
    "lru-cache": "11.0.2",
    "marked": "14.1.4",
    "nanoid": "5.0.9",
    "p-retry": "6.2.1",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "pino-pretty": "13.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.1",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.28.1",
    "esbuild": "0.24.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
